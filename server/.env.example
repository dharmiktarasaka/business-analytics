# =========================================================================
# STRATIQ BACKEND - ENVIRONMENT VARIABLES FOR RENDER DEPLOYMENT
# Copy these values into Render Web Service -> Environment Variables
# =========================================================================

# Node Environment
NODE_ENV=production

# Render automatically supplies PORT (typically 10000 or assigned dynamically)
# PORT=5000

# MongoDB Atlas Connection String (Replace with your actual MongoDB URI in Render)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/stratiq_db?retryWrites=true&w=majority

# Google Gemini AI API Configuration (Replace with your Gemini API key in Render)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Admin Secret Passkey (used by standalone admin portal to authenticate)
ADMIN_SECRET_KEY=your_admin_secret_key_here

# AES-256 Master Encryption Key for User Passwords
PASSWORD_ENCRYPTION_KEY=your_aes256_encryption_key_here

# CORS Origin: Comma-separated list of allowed frontend URLs (or * for all)
# e.g., https://your-main-app.vercel.app,https://your-admin-app.vercel.app
CORS_ORIGIN=*

# Dev Authentication Bypass (set false in production)
ALLOW_DEV_AUTH_BYPASS=false
